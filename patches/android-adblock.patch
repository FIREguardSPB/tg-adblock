@@ -0,0 +1,51 @@
+package com.tgadblock;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+import android.os.PowerManager;
+import android.provider.Settings;
+
+/**
+ * Without FCM, background notifications depend on the keep-alive foreground service staying
+ * alive — and on Android 12+/16 a foreground service can only be (re)started from the background
+ * if the app is exempt from battery optimization. We can't grant that ourselves, so on startup we
+ * prompt the user once with the system one-tap dialog. (Aggressive OEMs like ColorOS may also need
+ * their own "auto-start / don't freeze" toggle, which only the user can set.)
+ */
+public final class BackgroundConnection {
+    private BackgroundConnection() {}
+
+    private static final String PREFS = "tgadblock_update";
+    private static final String KEY_ASKED = "batt_opt_asked";
+
+    public static boolean isIgnoringBatteryOptimizations(Context ctx) {
+        try {
+            PowerManager pm = (PowerManager) ctx.getSystemService(Context.POWER_SERVICE);
+            return pm != null && pm.isIgnoringBatteryOptimizations(ctx.getPackageName());
+        } catch (Throwable ignore) {
+            return true; // unknown -> don't nag
+        }
+    }
+
+    /** Prompt once per install for the battery-optimization exemption, if not already granted. */
+    public static void maybePrompt(Activity activity) {
+        if (activity == null) return;
+        try {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.M) return;
+            if (isIgnoringBatteryOptimizations(activity)) return;
+            SharedPreferences sp = activity.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            if (sp.getBoolean(KEY_ASKED, false)) return;
+            sp.edit().putBoolean(KEY_ASKED, true).apply();
+            Intent i = new Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS);
+            i.setData(Uri.parse("package:" + activity.getPackageName()));
+            activity.startActivity(i);
+        } catch (Throwable ignore) {
+            // some OEMs don't honor the direct request action; the user can still grant it via
+            // system Settings -> Battery. We don't fall back to a settings deep-link to avoid loops.
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/Core.java b/TMessagesProj/src/main/java/com/tgadblock/Core.java
new file mode 100644
index 00000000..23bf9d0c
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/Core.java
@@ -0,0 +1,162 @@
+package com.tgadblock;
+
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Portable ad-detection core (Java port).
+ *
+ * Byte-for-byte twin of the Python reference (tg_adblock) and the C++ core:
+ * FNV-1a over UTF-8 bytes, classic 64-bit SimHash, and the same layered
+ * keyword/sender/SimHash decision. Verified identical to Python via generated
+ * test vectors (see TestCore.java + gen_vectors_java.py).
+ *
+ * As in the other ports, text normalization (text -> tokens/features) is NOT
+ * done here; on Android it is done with the platform/ICU-aware helpers in
+ * AdFilter so it matches Python's NFKC + \w+ tokenization.
+ */
+public final class Core {
+    private Core() {}
+
+    private static final long FNV_OFFSET = 0xCBF29CE484222325L;
+    private static final long FNV_PRIME = 0x100000001B3L;
+
+    public static long fnv1a64(String feature) {
+        long h = FNV_OFFSET;
+        for (byte b : feature.getBytes(java.nio.charset.StandardCharsets.UTF_8)) {
+            h ^= (b & 0xFFL);
+            h *= FNV_PRIME; // wraps mod 2^64 (signed long arithmetic is identical)
+        }
+        return h;
+    }
+
+    public static long simhash(List<String> features) {
+        if (features.isEmpty()) {
+            return 0L;
+        }
+        int[] v = new int[64];
+        for (String feat : features) {
+            long h = fnv1a64(feat);
+            for (int i = 0; i < 64; i++) {
+                if (((h >>> i) & 1L) != 0) v[i] += 1;
+                else v[i] -= 1;
+            }
+        }
+        long out = 0L;
+        for (int i = 0; i < 64; i++) {
+            if (v[i] > 0) out |= (1L << i);
+        }
+        return out;
+    }
+
+    public static int hamming(long a, long b) {
+        return Long.bitCount(a ^ b);
+    }
+
+    public static final class Config {
+        // EXPERIMENTAL: thresholds loosened to ~70% similarity (SimHash distance 19/64 ≈ 70%).
+        // simPercent is the single user-facing knob; getConfig() derives the thresholds below from it.
+        public int simPercent = 80;
+        public int simhashThreshold = 19; // ads: SimHash near-dup match (was 8 ≈ 87%)
+        public double kwRatio = 0.35;
+        public int kwMin = 3;
+        public double kwStrongRatio = 0.7;
+        // cross-channel duplicate-news auto-hide
+        public boolean dedupEnabled = true;
+        public int dupThreshold = 19;      // SimHash Hamming distance (lower = more similar required)
+        public double dupKwRatio = 0.7;    // OR: keyword Jaccard overlap
+        public int dupMinTokens = 8;       // skip messages shorter than this (avoid hiding short posts)
+        public int dupSeenMaxAgeDays = 14; // prune the seen-journal older than this
+        public int dupHiddenMaxAgeDays = 180; // prune persisted hide-decisions older than this
+        public boolean markHiddenRead = true; // mark hidden ads/dups read on the server (sync to desktop)
+        // EXPERIMENTAL: lexical (SimHash + keyword) and semantic (embeddings) dedup can be
+        // toggled INDEPENDENTLY. A post is a duplicate if EITHER enabled path matches.
+        public boolean lexicalEnabled = true;   // SimHash near-dup OR keyword Jaccard (cheap; catches identical dups)
+        public boolean semanticEnabled = true;  // on-device embedding cosine (catches paraphrases)
+        public double cosThreshold = 0.7; // derived from simPercent
+    }
+
+    public static final class Rule {
+        public long id;
+        public String senderId = "";   // empty => no sender bound
+        public boolean blockSender = false;
+        public boolean hasSimhash = false;
+        public long simhash = 0L;
+        public Set<String> keywords = java.util.Collections.emptySet();
+        public Set<String> domains = java.util.Collections.emptySet();
+        public boolean enabled = true;
+    }
+
+    public static final class MsgFeat {
+        public String senderId = "";
+        public long simhash = 0L;
+        public Set<String> tokens = java.util.Collections.emptySet();
+        public Set<String> domains = java.util.Collections.emptySet();
+    }
+
+    // A previously-seen post, for cross-channel duplicate detection.
+    public static final class SeenPost {
+        public String key = "";
+        public long dialogId = 0L;
+        public long simhash = 0L;
+        public Set<String> keywords = java.util.Collections.emptySet();
+        public int date = 0;
+        public float[] embedding = null; // semantic vector (null unless semantic mode on)
+    }
+
+    public static final class Match {
+        public boolean blocked = false;
+        public long ruleId = -1;
+        public String reason = "";
+        public int distance = -1;
+    }
+
+    private static int intersectionSize(Set<String> a, Set<String> b) {
+        Set<String> small = (a.size() <= b.size()) ? a : b;
+        Set<String> big = (a.size() <= b.size()) ? b : a;
+        int n = 0;
+        for (String x : small) if (big.contains(x)) n++;
+        return n;
+    }
+
+    public static Match classify(List<Rule> rules, MsgFeat msg, Config cfg) {
+        for (Rule rule : rules) {
+            if (!rule.enabled) continue;
+            boolean senderMatch = rule.senderId != null && !rule.senderId.isEmpty()
+                    && rule.senderId.equals(msg.senderId);
+
+            if (rule.blockSender && senderMatch) {
+                return match(rule.id, "sender", -1);
+            }
+            if (rule.hasSimhash && !msg.tokens.isEmpty()) {
+                int d = hamming(rule.simhash, msg.simhash);
+                if (d <= cfg.simhashThreshold) {
+                    return match(rule.id, "simhash", d);
+                }
+            }
+            if (!rule.keywords.isEmpty() && rule.keywords.size() >= cfg.kwMin
+                    && !msg.tokens.isEmpty()) {
+                double overlap = (double) intersectionSize(rule.keywords, msg.tokens)
+                        / (double) rule.keywords.size();
+                boolean domainMatch = !rule.domains.isEmpty()
+                        && intersectionSize(rule.domains, msg.domains) > 0;
+                if (overlap >= cfg.kwRatio && (senderMatch || domainMatch)) {
+                    return match(rule.id, "keyword+context", -1);
+                }
+                if (overlap >= cfg.kwStrongRatio) {
+                    return match(rule.id, "keyword", -1);
+                }
+            }
+        }
+        return new Match();
+    }
+
+    private static Match match(long id, String reason, int distance) {
+        Match m = new Match();
+        m.blocked = true;
+        m.ruleId = id;
+        m.reason = reason;
+        m.distance = distance;
+        return m;
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/Embedder.java b/TMessagesProj/src/main/java/com/tgadblock/Embedder.java
