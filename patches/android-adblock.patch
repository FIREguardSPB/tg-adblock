@@ -0,0 +1,139 @@
+package com.tgadblock;
+
+import android.content.Context;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.util.HashMap;
+import java.util.Map;
+
+import ai.onnxruntime.OnnxTensor;
+import ai.onnxruntime.OrtEnvironment;
+import ai.onnxruntime.OrtSession;
+
+/**
+ * On-device semantic text embedder (rubert-tiny2, int8 ONNX) for "smart" duplicate
+ * detection. Pure-local: WordPiece tokenize -> ONNX Runtime -> mean-pool -> L2-norm.
+ * Lazy: loads only when the semantic mode is enabled; any failure (old phone, missing
+ * model) leaves it unavailable and callers fall back to SimHash.
+ *
+ * IMPORTANT: embed() runs the transformer (~10-30 ms) — call it ONLY off the UI thread
+ * (the journaling executor), never from onMeasure/render.
+ */
+public final class Embedder {
+    public static final int DIM = 312;
+    private static final int MAX_TOKENS = 96;
+
+    private static volatile Embedder instance;
+    private OrtEnvironment env;
+    private OrtSession session;
+    private WordPiece tokenizer;
+    private volatile boolean ready;
+    private volatile boolean failed;
+
+    public static Embedder get() {
+        if (instance == null) {
+            synchronized (Embedder.class) {
+                if (instance == null) instance = new Embedder();
+            }
+        }
+        return instance;
+    }
+
+    /** Try to load the model+tokenizer once. Returns true if usable. Safe to call repeatedly. */
+    public synchronized boolean ensureLoaded(Context ctx) {
+        if (ready) return true;
+        if (failed) return false;
+        try {
+            tokenizer = WordPiece.fromAsset(ctx, "tgadblock/rubert_vocab.txt");
+            byte[] model = readAsset(ctx, "tgadblock/rubert.onnx");
+            env = OrtEnvironment.getEnvironment();
+            OrtSession.SessionOptions opts = new OrtSession.SessionOptions();
+            // Keep CPU/heat in check: single-threaded, sequential, and — critically — tell the ORT
+            // thread pool NOT to busy-spin while idle. By default it spin-waits between inferences,
+            // pinning a core at ~100% even when no post is being embedded. allow_spinning=0 makes
+            // the threads block instead. This is the main fix for the "2 cores at 100%" heat.
+            try { opts.setIntraOpNumThreads(1); } catch (Throwable ignore) {}
+            try { opts.setInterOpNumThreads(1); } catch (Throwable ignore) {}
+            try { opts.setExecutionMode(OrtSession.SessionOptions.ExecutionMode.SEQUENTIAL); } catch (Throwable ignore) {}
+            try { opts.addConfigEntry("session.intra_op.allow_spinning", "0"); } catch (Throwable ignore) {}
+            try { opts.addConfigEntry("session.inter_op.allow_spinning", "0"); } catch (Throwable ignore) {}
+            session = env.createSession(model, opts);
+            ready = true;
+            return true;
+        } catch (Throwable t) {
+            failed = true; // old device / missing lib / bad asset -> degrade to SimHash
+            return false;
+        }
+    }
+
+    public boolean isReady() {
+        return ready;
+    }
+
+    /** Returns an L2-normalized 312-d embedding, or null on any failure. */
+    public synchronized float[] embed(String text) {
+        if (!ready || text == null) return null;
+        try {
+            int[] ids = tokenizer.encode(text, MAX_TOKENS);
+            int n = ids.length;
+            long[][] inputIds = new long[1][n];
+            long[][] mask = new long[1][n];
+            long[][] types = new long[1][n];
+            for (int i = 0; i < n; i++) {
+                inputIds[0][i] = ids[i];
+                mask[0][i] = 1L;
+                types[0][i] = 0L;
+            }
+            Map<String, OnnxTensor> in = new HashMap<>();
+            OnnxTensor tIds = OnnxTensor.createTensor(env, inputIds);
+            OnnxTensor tMask = OnnxTensor.createTensor(env, mask);
+            OnnxTensor tTypes = OnnxTensor.createTensor(env, types);
+            in.put("input_ids", tIds);
+            in.put("attention_mask", tMask);
+            in.put("token_type_ids", tTypes);
+            float[] emb = new float[DIM];
+            try (OrtSession.Result res = session.run(in)) {
+                float[][][] hidden = (float[][][]) res.get(0).getValue(); // [1][n][DIM]
+                for (int t = 0; t < n; t++) {
+                    float[] row = hidden[0][t];
+                    for (int d = 0; d < DIM; d++) emb[d] += row[d];
+                }
+            } finally {
+                tIds.close();
+                tMask.close();
+                tTypes.close();
+            }
+            double norm = 0;
+            for (int d = 0; d < DIM; d++) {
+                emb[d] /= n; // mean pool (all positions masked-in)
+                norm += (double) emb[d] * emb[d];
+            }
+            norm = Math.sqrt(norm);
+            if (norm > 1e-9) {
+                for (int d = 0; d < DIM; d++) emb[d] /= (float) norm;
+            }
+            return emb;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /** Cosine similarity of two L2-normalized vectors = dot product. */
+    public static double cosine(float[] a, float[] b) {
+        if (a == null || b == null || a.length != b.length) return -1;
+        double s = 0;
+        for (int i = 0; i < a.length; i++) s += (double) a[i] * b[i];
+        return s;
+    }
+
+    private static byte[] readAsset(Context ctx, String path) throws Exception {
+        try (InputStream is = ctx.getAssets().open(path)) {
+            ByteArrayOutputStream bos = new ByteArrayOutputStream(1 << 20);
+            byte[] buf = new byte[1 << 16];
+            int r;
+            while ((r = is.read(buf)) > 0) bos.write(buf, 0, r);
+            return bos.toByteArray();
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/Normalize.java b/TMessagesProj/src/main/java/com/tgadblock/Normalize.java
new file mode 100644
index 00000000..683ee79a
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/Normalize.java
@@ -0,0 +1,94 @@
+package com.tgadblock;
+
+import java.text.Normalizer;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Text normalization for the Android port — pure JDK (no android.* deps), so it
+ * compiles and is parity-tested off-device. Mirrors tg_adblock.normalize:
+ * NFKC + lowercase + strip urls/mentions + Unicode-aware \w tokenization.
+ */
+public final class Normalize {
+    private Normalize() {}
+
+    private static final Pattern URL = Pattern.compile(
+            "(?:https?://|www\\.)\\S+"
+          + "|\\b\\S+\\.(?:ru|com|net|org|io|me|app|xyz|cc|biz|info)\\b/?\\S*",
+            Pattern.CASE_INSENSITIVE);
+    private static final Pattern TME = Pattern.compile("\\bt\\.me/\\S+", Pattern.CASE_INSENSITIVE);
+    private static final Pattern MENTION = Pattern.compile("@[A-Za-z0-9_]{3,}");
+    private static final Pattern WS = Pattern.compile("\\s+");
+    // NB: Android's java.util.regex rejects Pattern.UNICODE_CHARACTER_CLASS, so we
+    // match Unicode letters+numbers explicitly via \p{L}\p{N} — works on both
+    // Android and the desktop JDK and stays parity-identical to Python's \w.
+    private static final Pattern TOKEN = Pattern.compile("[\\p{L}\\p{N}]+");
+
+    private static final Set<String> STOPWORDS = new HashSet<>(Arrays.asList(
+        "и","в","во","не","что","он","на","я","с","со","как","а","то","все",
+        "она","так","его","но","да","ты","к","у","же","вы","за","бы","по",
+        "только","ее","мне","было","вот","от","меня","о","из","ему","теперь",
+        "когда","даже","ну","вдруг","ли","если","уже","или","быть","был","до",
+        "вас","нибудь","опять","уж","вам","ведь","там","потом","себя","ничего",
+        "ей","может","они","тут","где","есть","надо","для","это","этот","эта",
+        "эти","тот","том","чем","чтобы","нас","про",
+        "the","a","an","and","or","but","if","of","to","in","on","for","with",
+        "as","is","are","was","be","this","that","it","at","by","from","you",
+        "your","we","our","can","will","all","not","have"
+    ));
+
+    public static String normalizeText(String s) {
+        if (s == null || s.isEmpty()) return "";
+        String n = Normalizer.normalize(s, Normalizer.Form.NFKC).toLowerCase(Locale.ROOT);
+        n = URL.matcher(n).replaceAll(" ");
+        n = TME.matcher(n).replaceAll(" ");
+        n = MENTION.matcher(n).replaceAll(" ");
+        return WS.matcher(n).replaceAll(" ").trim();
+    }
+
+    public static List<String> tokens(String s) {
+        List<String> out = new ArrayList<>();
+        Matcher m = TOKEN.matcher(normalizeText(s));
+        while (m.find()) out.add(m.group());
+        return out;
+    }
+
+    public static Set<String> tokenSet(String s) {
+        return new HashSet<>(tokens(s));
+    }
+
+    private static List<String> significant(String s) {
+        List<String> out = new ArrayList<>();
+        for (String t : tokens(s)) {
+            if (t.length() >= 3 && !STOPWORDS.contains(t)) out.add(t);
+        }
+        return out;
+    }
+
+    public static Set<String> keywords(String s) {
+        Set<String> out = new HashSet<>();
+        for (String t : tokens(s)) {
+            if (t.length() >= 4 && !STOPWORDS.contains(t)) out.add(t);
+        }
+        return out;
+    }
+
+    public static List<String> features(String s) {
+        List<String> sig = significant(s);
+        List<String> out = new ArrayList<>(sig);
+        for (int i = 0; i + 1 < sig.size(); i++) {
+            out.add(sig.get(i) + "_" + sig.get(i + 1));
+        }
+        return out;
+    }
+
+    public static long simhashOf(String s) {
+        return Core.simhash(features(s));
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/UpdateChecker.java b/TMessagesProj/src/main/java/com/tgadblock/UpdateChecker.java
new file mode 100644
index 00000000..9ec6c275
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/UpdateChecker.java
@@ -0,0 +1,169 @@
+package com.tgadblock;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Once a day, ask GitHub for the latest published ad-blocker release and, if it
+ * is newer than this build ({@link Version#ADBLOCK_VERSION}), post a notification
+ * that opens the APK download. Everything is best-effort and swallows failures —
+ * a missing network / permission must never affect the host app.
+ *
+ * Install is intentionally NOT silent: tapping the notification opens the release
+ * APK in the browser and the user installs it like any sideload (an in-place
+ * update keeps all blocked-ad rules, since package + signing key are unchanged).
+ */
+public final class UpdateChecker {
+    private UpdateChecker() {}
+
+    private static final String PREFS = "tgadblock_update";
+    private static final String KEY_LAST = "last_check";
+    private static final long INTERVAL_MS = 24L * 60 * 60 * 1000; // once a day
+    private static final String CHANNEL_ID = "tgadblock_updates";
+    private static final int NOTIF_ID = 0x7ADB10C;
+    private static final Pattern TAG_VERSION = Pattern.compile("v(\\d+)");
+
+    public static void maybeCheck(Context ctx) {
+        if (ctx == null) return;
+        try {
+            final Context app = ctx.getApplicationContext();
+            SharedPreferences sp = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            long now = System.currentTimeMillis();
+            if (now - sp.getLong(KEY_LAST, 0) < INTERVAL_MS) return;
+            sp.edit().putLong(KEY_LAST, now).apply();
+            Thread t = new Thread(new Runnable() {
+                @Override public void run() {
+                    check(app);
+                }
+            }, "tgadblock-update");
+            t.setDaemon(true);
+            t.start();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static void check(Context app) {
+        HttpURLConnection conn = null;
+        try {
+            URL url = new URL("https://api.github.com/repos/" + Version.REPO + "/releases/latest");
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setRequestProperty("Accept", "application/vnd.github+json");
+            conn.setRequestProperty("User-Agent", "tg-adblock");
+            conn.setConnectTimeout(15000);
+            conn.setReadTimeout(15000);
+            if (conn.getResponseCode() != 200) return;
+            JSONObject o = new JSONObject(readAll(conn.getInputStream()));
+
+            Matcher m = TAG_VERSION.matcher(o.optString("tag_name", ""));
+            if (!m.find()) return;
+            int remote = Integer.parseInt(m.group(1));
+            if (remote <= Version.ADBLOCK_VERSION) return;
+
+            String apkUrl = null;
+            JSONArray assets = o.optJSONArray("assets");
+            if (assets != null) {
+                for (int i = 0; i < assets.length(); i++) {
+                    JSONObject a = assets.getJSONObject(i);
+                    if (a.optString("name", "").toLowerCase(Locale.ROOT).endsWith(".apk")) {
+                        apkUrl = a.optString("browser_download_url", null);
+                        break;
+                    }
+                }
+            }
+            if (apkUrl == null) {
+                apkUrl = o.optString("html_url", null);
+            }
+            postNotification(app, remote, apkUrl);
+        } catch (Throwable ignore) {
+        } finally {
+            if (conn != null) {
+                try { conn.disconnect(); } catch (Throwable ignore) {}
+            }
+        }
+    }
+
+    private static void postNotification(Context app, int remote, String url) {
+        if (url == null || url.isEmpty()) return;
+        try {
+            NotificationManager nm =
+                    (NotificationManager) app.getSystemService(Context.NOTIFICATION_SERVICE);
+            if (nm == null) return;
+            boolean ru = isRu();
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                nm.createNotificationChannel(new NotificationChannel(CHANNEL_ID,
+                        ru ? "Обновления Telegram AAD" : "Telegram AAD updates",
+                        NotificationManager.IMPORTANCE_DEFAULT));
+            }
+
+            // Tap -> download the APK via DownloadManager and launch the installer (handled by
+            // UpdateInstallReceiver), instead of opening the GitHub page in a browser.
+            Intent dl = new Intent(app, UpdateInstallReceiver.class);
+            dl.setAction(UpdateInstallReceiver.ACTION_START);
+            dl.putExtra(UpdateInstallReceiver.EXTRA_URL, url);
+            int piFlags = PendingIntent.FLAG_UPDATE_CURRENT;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                piFlags |= PendingIntent.FLAG_IMMUTABLE;
+            }
+            PendingIntent pi = PendingIntent.getBroadcast(app, 0, dl, piFlags);
+
+            String title = ru ? "Доступна новая версия Telegram AAD"
+                              : "New Telegram AAD version available";
+            String text = ru ? ("Версия v" + remote + " — нажмите, чтобы скачать и обновить")
+                             : ("Version v" + remote + " — tap to download and update");
+
+            Notification.Builder b = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+                    ? new Notification.Builder(app, CHANNEL_ID)
+                    : new Notification.Builder(app);
+            Notification n = b
+                    .setSmallIcon(android.R.drawable.stat_sys_download_done)
+                    .setContentTitle(title)
+                    .setContentText(text)
+                    .setStyle(new Notification.BigTextStyle().bigText(text))
+                    .setAutoCancel(true)
+                    .setContentIntent(pi)
+                    .build();
+            nm.notify(NOTIF_ID, n);
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static boolean isRu() {
+        try {
+            org.telegram.messenger.LocaleController.LocaleInfo li =
+                    org.telegram.messenger.LocaleController.getInstance().getCurrentLocaleInfo();
+            return li != null && li.shortName != null
+                    && li.shortName.toLowerCase(Locale.ROOT).startsWith("ru");
+        } catch (Throwable ignore) {
+            return false;
+        }
+    }
+
+    private static String readAll(InputStream is) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        byte[] buf = new byte[4096];
+        int n;
+        while ((n = is.read(buf)) > 0) {
+            bos.write(buf, 0, n);
+        }
+        return new String(bos.toByteArray(), StandardCharsets.UTF_8);
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/UpdateInstallReceiver.java b/TMessagesProj/src/main/java/com/tgadblock/UpdateInstallReceiver.java
new file mode 100644
index 00000000..b4f4cebe
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/UpdateInstallReceiver.java
@@ -0,0 +1,116 @@
+package com.tgadblock;
+
+import android.app.DownloadManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Environment;
+import android.widget.Toast;
+
+import java.util.Locale;
+
+/**
+ * Turns the "update available" notification into a one-tap download+install instead of just
+ * opening GitHub in a browser. On tap we enqueue the release APK in the system DownloadManager
+ * (background, progress shown in the shade, survives process death); when it finishes we launch
+ * the package installer. The user still confirms once in the system "Install" dialog — a fully
+ * silent install needs device-owner/root, which we don't have. Package + signing key are
+ * unchanged, so it's an in-place update that keeps all blocked-ad rules.
+ */
+public final class UpdateInstallReceiver extends BroadcastReceiver {
+    public static final String ACTION_START = "com.tgadblock.UPDATE_DOWNLOAD";
+    public static final String EXTRA_URL = "url";
+
+    private static final String PREFS = "tgadblock_update";
+    private static final String KEY_DLID = "download_id";
+    private static final String APK_NAME = "tg-adblock-update.apk";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        if (context == null || intent == null) return;
+        final Context app = context.getApplicationContext();
+        try {
+            String action = intent.getAction();
+            if (ACTION_START.equals(action)) {
+                startDownload(app, intent.getStringExtra(EXTRA_URL));
+            } else if (DownloadManager.ACTION_DOWNLOAD_COMPLETE.equals(action)) {
+                onDownloadComplete(app, intent.getLongExtra(DownloadManager.EXTRA_DOWNLOAD_ID, -1));
+            }
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private void startDownload(Context app, String url) {
+        if (url == null || url.isEmpty()) return;
+        // SECURITY: this receiver is exported (to receive DOWNLOAD_COMPLETE), so another app could
+        // send ACTION_START. Only ever download from our own GitHub release URLs — never an
+        // attacker-supplied one. Anything else is ignored.
+        if (!url.startsWith("https://github.com/" + Version.REPO + "/")) return;
+        boolean ru = isRu();
+        // No APK asset (only the release page) -> just open it like before.
+        if (!url.toLowerCase(Locale.ROOT).endsWith(".apk")) {
+            openUrl(app, url);
+            return;
+        }
+        DownloadManager dm = (DownloadManager) app.getSystemService(Context.DOWNLOAD_SERVICE);
+        if (dm == null) {
+            openUrl(app, url);
+            return;
+        }
+        try {
+            DownloadManager.Request req = new DownloadManager.Request(Uri.parse(url));
+            req.setTitle(ru ? "Обновление Telegram AAD" : "Telegram AAD update");
+            req.setMimeType("application/vnd.android.package-archive");
+            // app-specific external dir: no storage permission needed, readable for install
+            req.setDestinationInExternalFilesDir(app, Environment.DIRECTORY_DOWNLOADS, APK_NAME);
+            req.setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED);
+            long id = dm.enqueue(req);
+            app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putLong(KEY_DLID, id).apply();
+            Toast.makeText(app, ru ? "Скачивание обновления…" : "Downloading update…",
+                    Toast.LENGTH_SHORT).show();
+        } catch (Throwable t) {
+            openUrl(app, url);
+        }
+    }
+
+    private void onDownloadComplete(Context app, long completed) {
+        if (completed < 0) return;
+        SharedPreferences sp = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        if (completed != sp.getLong(KEY_DLID, -1)) return; // not our download
+        DownloadManager dm = (DownloadManager) app.getSystemService(Context.DOWNLOAD_SERVICE);
+        if (dm == null) return;
+        Uri uri = dm.getUriForDownloadedFile(completed); // content:// uri, grantable to installer
+        if (uri == null) return;
+        try {
+            Intent install = new Intent(Intent.ACTION_VIEW);
+            install.setDataAndType(uri, "application/vnd.android.package-archive");
+            install.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            app.startActivity(install);
+        } catch (Throwable ignore) {
+            // if the system installer can't be launched, the DownloadManager notification remains
+            // tappable as a fallback (it views the same apk).
+        }
+    }
+
+    private void openUrl(Context app, String url) {
+        try {
+            Intent view = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
+            view.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            app.startActivity(view);
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static boolean isRu() {
+        try {
+            org.telegram.messenger.LocaleController.LocaleInfo li =
+                    org.telegram.messenger.LocaleController.getInstance().getCurrentLocaleInfo();
+            return li != null && li.shortName != null
+                    && li.shortName.toLowerCase(Locale.ROOT).startsWith("ru");
+        } catch (Throwable ignore) {
+            return false;
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/Version.java b/TMessagesProj/src/main/java/com/tgadblock/Version.java
new file mode 100644
index 00000000..081df7c2
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/Version.java
@@ -0,0 +1,19 @@
+package com.tgadblock;
+
+/**
+ * Single source of truth for the ad-blocker build version.
+ *
+ * Bump {@link #ADBLOCK_VERSION} on every published build. CI tags the GitHub
+ * release {@code tg-adblock-v<ADBLOCK_VERSION>} (it greps this constant out of
+ * the patch), and the in-app {@link UpdateChecker} compares this baked-in value
+ * to the latest release to decide whether to offer an update.
+ */
+public final class Version {
+    private Version() {}
+
+    public static final int ADBLOCK_VERSION = 10;
+    public static final String ADBLOCK_VERSION_NAME = "10.0";
+
+    /** owner/repo that publishes the signed APKs. */
+    public static final String REPO = "FIREguardSPB/tg-adblock";
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/WordPiece.java b/TMessagesProj/src/main/java/com/tgadblock/WordPiece.java
new file mode 100644
index 00000000..961475ea
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/WordPiece.java
@@ -0,0 +1,161 @@
+package com.tgadblock;
+
+import android.content.Context;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Pure-Java BERT WordPiece tokenizer for rubert-tiny2 (cased, no accent stripping).
+ * Faithful port of HuggingFace BertTokenizer's BasicTokenizer + WordpieceTokenizer,
+ * so token ids match the model. No native deps.
+ */
+public final class WordPiece {
+    private final Map<String, Integer> vocab;
+    private final int unkId;
+    private final int clsId;
+    private final int sepId;
+    private static final int MAX_CHARS_PER_WORD = 100;
+
+    private WordPiece(Map<String, Integer> vocab) {
+        this.vocab = vocab;
+        this.unkId = vocab.containsKey("[UNK]") ? vocab.get("[UNK]") : 1;
+        this.clsId = vocab.containsKey("[CLS]") ? vocab.get("[CLS]") : 2;
+        this.sepId = vocab.containsKey("[SEP]") ? vocab.get("[SEP]") : 3;
+    }
+
+    public static WordPiece fromAsset(Context ctx, String assetPath) throws Exception {
+        Map<String, Integer> v = new HashMap<>(100000);
+        try (InputStream is = ctx.getAssets().open(assetPath);
+             BufferedReader br = new BufferedReader(new InputStreamReader(is, StandardCharsets.UTF_8))) {
+            String line;
+            int idx = 0;
+            while ((line = br.readLine()) != null) {
+                // vocab.txt: one token per line; trailing \r already stripped by readLine
+                v.put(line, idx++);
+            }
+        }
+        return new WordPiece(v);
+    }
+
+    /** Encode to ids with [CLS] ... [SEP], truncated so the total length <= maxLen. */
+    public int[] encode(String text, int maxLen) {
+        List<Integer> ids = new ArrayList<>();
+        ids.add(clsId);
+        int budget = Math.max(2, maxLen) - 2; // room for [CLS] and [SEP]
+        outer:
+        for (String basic : basicTokenize(text)) {
+            for (int wp : wordpiece(basic)) {
+                if (ids.size() - 1 >= budget) break outer;
+                ids.add(wp);
+            }
+        }
+        ids.add(sepId);
+        int[] out = new int[ids.size()];
+        for (int i = 0; i < out.length; i++) out[i] = ids.get(i);
+        return out;
+    }
+
+    // ---- BasicTokenizer (cased) ----
+    private List<String> basicTokenize(String text) {
+        StringBuilder cleaned = new StringBuilder(text.length());
+        for (int i = 0; i < text.length(); ) {
+            int cp = text.codePointAt(i);
+            i += Character.charCount(cp);
+            if (cp == 0 || cp == 0xFFFD || isControl(cp)) continue;
+            if (isWhitespace(cp)) {
+                cleaned.append(' ');
+            } else if (isChinese(cp)) {
+                cleaned.append(' ').appendCodePoint(cp).append(' ');
+            } else {
+                cleaned.appendCodePoint(cp);
+            }
+        }
+        List<String> out = new ArrayList<>();
+        for (String token : cleaned.toString().trim().split("\\s+")) {
+            if (token.isEmpty()) continue;
+            // run_split_on_punc
+            StringBuilder cur = new StringBuilder();
+            for (int i = 0; i < token.length(); ) {
+                int cp = token.codePointAt(i);
+                i += Character.charCount(cp);
+                if (isPunct(cp)) {
+                    if (cur.length() > 0) { out.add(cur.toString()); cur.setLength(0); }
+                    out.add(new String(Character.toChars(cp)));
+                } else {
+                    cur.appendCodePoint(cp);
+                }
+            }
+            if (cur.length() > 0) out.add(cur.toString());
+        }
+        return out;
+    }
+
+    // ---- WordpieceTokenizer ----
+    private List<Integer> wordpiece(String token) {
+        List<Integer> out = new ArrayList<>();
+        if (token.length() > MAX_CHARS_PER_WORD) {
+            out.add(unkId);
+            return out;
+        }
+        int start = 0;
+        boolean bad = false;
+        List<Integer> sub = new ArrayList<>();
+        int n = token.length();
+        while (start < n) {
+            int end = n;
+            Integer curId = null;
+            while (start < end) {
+                String piece = token.substring(start, end);
+                if (start > 0) piece = "##" + piece;
+                Integer id = vocab.get(piece);
+                if (id != null) { curId = id; break; }
+                end--;
+            }
+            if (curId == null) { bad = true; break; }
+            sub.add(curId);
+            start = end;
+        }
+        if (bad) out.add(unkId);
+        else out.addAll(sub);
+        return out;
+    }
+
+    // ---- BERT char predicates ----
+    private static boolean isWhitespace(int cp) {
+        if (cp == ' ' || cp == '\t' || cp == '\n' || cp == '\r') return true;
+        return Character.getType(cp) == Character.SPACE_SEPARATOR;
+    }
+
+    private static boolean isControl(int cp) {
+        if (cp == '\t' || cp == '\n' || cp == '\r') return false;
+        int t = Character.getType(cp);
+        return t == Character.CONTROL || t == Character.FORMAT
+                || t == Character.PRIVATE_USE || t == Character.SURROGATE
+                || t == Character.UNASSIGNED || t == Character.LINE_SEPARATOR
+                || t == Character.PARAGRAPH_SEPARATOR;
+    }
+
+    private static boolean isPunct(int cp) {
+        if ((cp >= 33 && cp <= 47) || (cp >= 58 && cp <= 64)
+                || (cp >= 91 && cp <= 96) || (cp >= 123 && cp <= 126)) return true;
+        int t = Character.getType(cp);
+        return t == Character.CONNECTOR_PUNCTUATION || t == Character.DASH_PUNCTUATION
+                || t == Character.START_PUNCTUATION || t == Character.END_PUNCTUATION
+                || t == Character.INITIAL_QUOTE_PUNCTUATION || t == Character.FINAL_QUOTE_PUNCTUATION
+                || t == Character.OTHER_PUNCTUATION;
+    }
+
+    private static boolean isChinese(int cp) {
+        return (cp >= 0x4E00 && cp <= 0x9FFF) || (cp >= 0x3400 && cp <= 0x4DBF)
+                || (cp >= 0x20000 && cp <= 0x2A6DF) || (cp >= 0x2A700 && cp <= 0x2B73F)
+                || (cp >= 0x2B740 && cp <= 0x2B81F) || (cp >= 0x2B820 && cp <= 0x2CEAF)
+                || (cp >= 0xF900 && cp <= 0xFAFF) || (cp >= 0x2F800 && cp <= 0x2FA1F);
+    }
+}
