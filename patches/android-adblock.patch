@@ -0,0 +1,401 @@
+package com.tgadblock;
+
+import android.content.Context;
+
+import org.telegram.messenger.MessageObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * In-client glue for the offline-validated detection pipeline (Android).
+ * Bridges MessageObject -> Normalize/Core and owns the SQLite rule store.
+ * Call {@link #init(Context)} once (e.g. from ApplicationLoader) before use.
+ */
+public final class AdFilter {
+    private static volatile AdFilter instance;
+
+    private final AdStore store;
+    private List<Core.Rule> rules;
+    private Core.Config config;
+    private final Map<Integer, Boolean> cache = new HashMap<>();
+    // cross-channel duplicate-news journal (bounded, persisted)
+    private static final int SEEN_CAP = 2500;
+    private final java.util.LinkedHashMap<String, Core.SeenPost> seen = new java.util.LinkedHashMap<>();
+    private final Map<String, Boolean> dupCache = new HashMap<>();
+    // persistent hide-decisions: a hidden dup stays hidden after journal rows are pruned
+    private final Set<String> hiddenDups = new HashSet<>();
+    // off-UI journaling of arriving posts (SimHash + SQLite insert)
+    private final java.util.concurrent.ExecutorService journalExec =
+            java.util.concurrent.Executors.newSingleThreadExecutor();
+
+    private static final Pattern DOMAIN = Pattern.compile(
+            "(?:https?://|www\\.)?([a-z0-9.-]+\\.(?:ru|com|net|org|io|me|app|xyz|cc|biz|info))");
+
+    private AdFilter(Context ctx) {
+        store = new AdStore(ctx);
+        seedDefaultsIfNeeded(ctx);
+        reload();
+    }
+
+    // On first launch, load the bundled starter ruleset so common ads are hidden
+    // out of the box. Preseed rules carry no sender, so they fire via SimHash
+    // near-dup, strong keyword overlap, or a known ad-domain match.
+    private void seedDefaultsIfNeeded(Context ctx) {
+        if (store.isSeeded()) {
+            return;
+        }
+        try (java.io.InputStream is = ctx.getAssets().open("adblock_default_rules.json")) {
+            java.io.ByteArrayOutputStream bos = new java.io.ByteArrayOutputStream();
+            byte[] buf = new byte[4096];
+            int n;
+            while ((n = is.read(buf)) > 0) {
+                bos.write(buf, 0, n);
+            }
+            org.json.JSONArray arr = new org.json.JSONArray(
+                    new String(bos.toByteArray(), java.nio.charset.StandardCharsets.UTF_8));
+            for (int i = 0; i < arr.length(); i++) {
+                org.json.JSONObject o = arr.getJSONObject(i);
+                store.addRule(
+                        "",
+                        o.optBoolean("block_sender", false),
+                        true,
+                        Long.parseUnsignedLong(o.getString("simhash")),
+                        jsonToSet(o.optJSONArray("keywords")),
+                        jsonToSet(o.optJSONArray("domains")),
+                        o.optString("text_sample", ""));
+            }
+        } catch (Throwable ignore) {
+            // missing/malformed asset -> skip preseed (manual tap-to-block still works)
+        }
+        store.markSeeded();
+    }
+
+    private static Set<String> jsonToSet(org.json.JSONArray a) {
+        Set<String> out = new HashSet<>();
+        if (a != null) {
+            for (int i = 0; i < a.length(); i++) {
+                out.add(a.optString(i));
+            }
+        }
+        return out;
+    }
+
+    public static void init(Context ctx) {
+        if (instance == null) {
+            synchronized (AdFilter.class) {
+                if (instance == null) instance = new AdFilter(ctx.getApplicationContext());
+            }
+        }
+    }
+
+    public static AdFilter getInstance() {
+        return instance;
+    }
+
+    public synchronized void reload() {
+        rules = store.loadRules();
+        config = store.getConfig();
+        cache.clear();
+        dupCache.clear();
+        seen.clear();
+        hiddenDups.clear();
+        // Prune by age once per init/reload (off the hot render path), BEFORE loading.
+        long now = System.currentTimeMillis() / 1000L;
+        try {
+            store.pruneSeenByAge(now - (long) config.dupSeenMaxAgeDays * 86400L);
+            store.pruneHiddenDups(now - (long) config.dupHiddenMaxAgeDays * 86400L);
+        } catch (Throwable ignore) {
+        }
+        java.util.List<Core.SeenPost> loaded = store.loadSeenPosts(SEEN_CAP);
+        // loaded is newest-first; insert oldest-first so LRU eviction drops the oldest.
+        for (int i = loaded.size() - 1; i >= 0; i--) {
+            seen.put(loaded.get(i).key, loaded.get(i));
+        }
+        hiddenDups.addAll(store.loadHiddenDupKeys());
+    }
+
+    // Cross-channel duplicate news: hide a channel post if an EARLIER-dated, very
+    // similar post from a DIFFERENT channel was already seen (the first stays, later
+    // copies hide). Similarity = SimHash near-dup OR high keyword overlap. Tunable
+    // via the dup_* meta keys. Only broadcast-channel posts participate (never
+    // private chats), so identical texts sent to two people are never hidden.
+    public synchronized boolean isDuplicateGroup(MessageObject.GroupedMessages group) {
+        if (group == null || group.messages == null) return false;
+        MessageObject cap = group.findCaptionMessageObject();
+        if (cap != null) return isDuplicate(cap);
+        for (int i = 0; i < group.messages.size(); i++) {
+            if (isDuplicate(group.messages.get(i))) return true;
+        }
+        return false;
+    }
+
+    public synchronized boolean isDuplicate(MessageObject mo) {
+        if (mo == null || config == null || !config.dedupEnabled) return false;
+        if (mo.messageOwner == null || !mo.messageOwner.post) return false; // channel posts only
+        String text = effectiveText(mo);
+        if (text == null || text.trim().isEmpty()) return false;
+        if (Normalize.tokenSet(text).size() < config.dupMinTokens) return false;
+        long did = mo.getDialogId();
+        String key = did + ":" + mo.getId();
+        Boolean cached = dupCache.get(key);
+        if (cached != null) return cached;
+        if (hiddenDups.contains(key)) { // persistent decision: stays hidden after journal pruning
+            dupCache.put(key, true);
+            return true;
+        }
+        long sh = Normalize.simhashOf(text);
+        Set<String> kw = Normalize.keywords(text);
+        int date = mo.messageOwner.date;
+        boolean dup = false;
+        for (Core.SeenPost s : seen.values()) {
+            if (s.dialogId == did) continue;     // only across different channels
+            if (s.date >= date) continue;        // the earliest-dated copy is the original
+            if (Core.hamming(s.simhash, sh) <= config.dupThreshold
+                    || jaccard(s.keywords, kw) >= config.dupKwRatio) {
+                dup = true;
+                break;
+            }
+        }
+        if (!seen.containsKey(key)) {
+            Core.SeenPost p = new Core.SeenPost();
+            p.key = key;
+            p.dialogId = did;
+            p.simhash = sh;
+            p.keywords = kw;
+            p.date = date;
+            seen.put(key, p);
+            try {
+                store.addSeenPost(key, did, sh, kw, date);
+            } catch (Throwable ignore) {
+            }
+            if (seen.size() > SEEN_CAP) {
+                java.util.Iterator<String> it = seen.keySet().iterator();
+                if (it.hasNext()) {
+                    it.next();
+                    it.remove();
+                }
+            }
+        }
+        if (dup && !hiddenDups.contains(key)) { // persist so it stays hidden later
+            hiddenDups.add(key);
+            try {
+                store.addHiddenDup(key, System.currentTimeMillis() / 1000L);
+            } catch (Throwable ignore) {
+            }
+        }
+        dupCache.put(key, dup);
+        return dup;
+    }
+
+    // Journal newly-arrived channel posts (called from MessagesController on the main
+    // thread). Filters on-thread, then does SimHash + dup-decision + SQLite off-thread.
+    // Deciding here (not just at render) lets notifications and the chat-list unread
+    // badge be suppressed for a duplicate the moment it arrives.
+    public void journalArrivals(java.util.ArrayList<MessageObject> messages) {
+        if (messages == null || messages.isEmpty()) return;
+        final int minTokens = config == null ? 8 : config.dupMinTokens;
+        final java.util.ArrayList<Object[]> batch = new java.util.ArrayList<>();
+        for (int i = 0; i < messages.size(); i++) {
+            MessageObject mo = messages.get(i);
+            if (mo == null || mo.messageOwner == null || !mo.messageOwner.post) continue; // channel posts only
+            if (mo.isOut()) continue;                       // never our own
+            if (!mo.isSent() || mo.isSending()) continue;   // skip local echoes (negative ids)
+            String text = effectiveText(mo);
+            if (text == null || text.trim().isEmpty()) continue;
+            if (Normalize.tokenSet(text).size() < minTokens) continue;
+            batch.add(new Object[]{mo.getDialogId() + ":" + mo.getId(), mo.getDialogId(), text, mo.messageOwner.date});
+        }
+        if (batch.isEmpty()) return;
+        journalExec.execute(() -> {
+            for (Object[] row : batch) {
+                try {
+                    journalOne((String) row[0], (Long) row[1], (String) row[2], (Integer) row[3]);
+                } catch (Throwable ignore) {
+                }
+            }
+        });
+    }
+
+    private synchronized void journalOne(String key, long did, String text, int date) {
+        if (config == null) return;
+        long sh = Normalize.simhashOf(text);
+        Set<String> kw = Normalize.keywords(text);
+        boolean dup = hiddenDups.contains(key);
+        if (!dup) {
+            for (Core.SeenPost s : seen.values()) {
+                if (s.dialogId == did) continue;
+                if (s.date >= date) continue;
+                if (Core.hamming(s.simhash, sh) <= config.dupThreshold
+                        || jaccard(s.keywords, kw) >= config.dupKwRatio) {
+                    dup = true;
+                    break;
+                }
+            }
+        }
+        if (dup && !hiddenDups.contains(key)) {
+            hiddenDups.add(key);
+            try {
+                store.addHiddenDup(key, System.currentTimeMillis() / 1000L);
+            } catch (Throwable ignore) {
+            }
+        }
+        if (!seen.containsKey(key)) {
+            Core.SeenPost p = new Core.SeenPost();
+            p.key = key;
+            p.dialogId = did;
+            p.simhash = sh;
+            p.keywords = kw;
+            p.date = date;
+            seen.put(key, p);
+            try {
+                store.addSeenPost(key, did, sh, kw, date, System.currentTimeMillis() / 1000L);
+            } catch (Throwable ignore) {
+            }
+            if (seen.size() > SEEN_CAP) {
+                java.util.Iterator<String> it = seen.keySet().iterator();
+                if (it.hasNext()) {
+                    it.next();
+                    it.remove();
+                }
+            }
+        }
+        dupCache.put(key, dup);
+    }
+
+    // Side-effect-free check for the chat-list / notifications: is this post a known
+    // hidden duplicate? (Reflects decisions already made at arrival or render.)
+    public synchronized boolean isKnownDuplicate(MessageObject mo) {
+        if (mo == null || config == null || !config.dedupEnabled) return false;
+        if (mo.messageOwner == null || !mo.messageOwner.post) return false;
+        String key = mo.getDialogId() + ":" + mo.getId();
+        if (hiddenDups.contains(key)) return true;
+        Boolean c = dupCache.get(key);
+        return c != null && c;
+    }
+
+    private static double jaccard(Set<String> a, Set<String> b) {
+        if (a.isEmpty() || b.isEmpty()) return 0;
+        Set<String> small = a.size() <= b.size() ? a : b;
+        Set<String> big = a.size() <= b.size() ? b : a;
+        int inter = 0;
+        for (String x : small) {
+            if (big.contains(x)) inter++;
+        }
+        int union = a.size() + b.size() - inter;
+        return union == 0 ? 0 : (double) inter / (double) union;
+    }
+
+    private static String textOf(MessageObject mo) {
+        if (mo.messageOwner != null && mo.messageOwner.message != null) {
+            return mo.messageOwner.message;
+        }
+        return mo.messageText != null ? mo.messageText.toString() : null;
+    }
+
+    // Inline-keyboard button labels. Lets us detect/block ads that carry no body
+    // text (round-video "video notes", stickers) but route to an ad via a button
+    // like "Игра в которой зарабатываю".
+    private static String buttonText(MessageObject mo) {
+        if (mo == null || mo.messageOwner == null
+                || mo.messageOwner.reply_markup == null
+                || mo.messageOwner.reply_markup.rows == null) {
+            return "";
+        }
+        StringBuilder sb = new StringBuilder();
+        for (TLRPC.TL_keyboardButtonRow row : mo.messageOwner.reply_markup.rows) {
+            if (row == null || row.buttons == null) continue;
+            for (TLRPC.KeyboardButton b : row.buttons) {
+                if (b != null && b.text != null && !b.text.isEmpty()) {
+                    if (sb.length() > 0) sb.append(' ');
+                    sb.append(b.text);
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    // Body text if present, otherwise the button labels. Messages with a body keep
+    // their previously-validated behaviour; button-only messages become detectable.
+    private static String effectiveText(MessageObject mo) {
+        String body = textOf(mo);
+        if (body != null && !body.trim().isEmpty()) {
+            return body;
+        }
+        return buttonText(mo);
+    }
+
+    // Whether the "Block as ad" menu item should be offered for this message.
+    public static boolean hasBlockableText(MessageObject mo) {
+        String t = effectiveText(mo);
+        return t != null && !t.trim().isEmpty();
+    }
+
+    private static String senderId(MessageObject mo) {
+        return String.valueOf(mo.getSenderId());
+    }
+
+    private static Set<String> domains(String raw) {
+        Set<String> out = new HashSet<>();
+        Matcher m = DOMAIN.matcher(raw.toLowerCase(Locale.ROOT));
+        while (m.find()) {
+            String host = m.group(1);
+            if (host.startsWith("www.")) host = host.substring(4);
+            out.add(host);
+        }
+        return out;
+    }
+
+    // A grouped media message (album) is rendered as one cell per item, but only
+    // the caption-bearing item carries the ad text. Treat the whole group as an ad
+    // if any of its items is — so every cell in the album collapses together
+    // instead of leaving orphaned photos and overlapping siblings.
+    public synchronized boolean isAdGroup(MessageObject.GroupedMessages group) {
+        if (group == null || group.messages == null) return false;
+        for (int i = 0; i < group.messages.size(); i++) {
+            if (isAd(group.messages.get(i))) return true;
+        }
+        return false;
+    }
+
+    public synchronized boolean isAd(MessageObject mo) {
+        if (mo == null || rules.isEmpty()) return false;
+        Integer key = mo.getId();
+        Boolean cached = cache.get(key);
+        if (cached != null) return cached;
+        String text = effectiveText(mo);
+        boolean blocked = false;
+        if (text != null && !text.trim().isEmpty()) {
+            Core.MsgFeat f = new Core.MsgFeat();
+            f.senderId = senderId(mo);
+            f.simhash = Normalize.simhashOf(text);
+            f.tokens = Normalize.tokenSet(text);
+            f.domains = domains(text);
+            blocked = Core.classify(rules, f, config).blocked;
+        }
+        cache.put(key, blocked);
+        return blocked;
+    }
+
+    public synchronized void blockItem(MessageObject mo) {
+        if (mo == null) return;
+        String text = effectiveText(mo);
+        if (text == null || text.trim().isEmpty()) return;
+        store.addRule(
+                senderId(mo),
+                /*blockSender=*/false,
+                /*hasSimhash=*/true,
+                Normalize.simhashOf(text),
+                Normalize.keywords(text),
+                domains(text),
+                text.length() > 280 ? text.substring(0, 280) : text);
+        reload();
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/AdStore.java b/TMessagesProj/src/main/java/com/tgadblock/AdStore.java
new file mode 100644
index 00000000..42d5186d
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/AdStore.java
@@ -0,0 +1,273 @@
+package com.tgadblock;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteOpenHelper;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * SQLite rule store (Android). Schema is the byte-compatible twin of the Python
+ * tg_adblock.rules and the C++ AdStore, so a rules.db produced by any of them
+ * loads here unchanged (verified bidirectionally for the Python<->C++ pair).
+ */
+public final class AdStore extends SQLiteOpenHelper {
+    private static final String DB_NAME = "adblock_rules.db";
+    private static final int DB_VERSION = 3;
+
+    public AdStore(Context ctx) {
+        super(ctx.getApplicationContext(), DB_NAME, null, DB_VERSION);
+    }
+
+    @Override
+    public void onCreate(SQLiteDatabase db) {
+        db.execSQL("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)");
+        db.execSQL("CREATE TABLE IF NOT EXISTS rules ("
+                + "id INTEGER PRIMARY KEY AUTOINCREMENT,"
+                + "created_at TEXT NOT NULL,"
+                + "origin TEXT NOT NULL DEFAULT 'manual',"
+                + "sender_id TEXT,"
+                + "sender_name TEXT,"
+                + "block_sender INTEGER NOT NULL DEFAULT 0,"
+                + "simhash TEXT,"
+                + "keywords TEXT NOT NULL DEFAULT '',"
+                + "domains TEXT NOT NULL DEFAULT '',"
+                + "text_sample TEXT NOT NULL DEFAULT '',"
+                + "enabled INTEGER NOT NULL DEFAULT 1)");
+        setDefaultMeta(db, "schema_version", "1");
+        setDefaultMeta(db, "simhash_threshold", "8");
+        setDefaultMeta(db, "kw_ratio", "0.35");
+        setDefaultMeta(db, "kw_min", "3");
+        setDefaultMeta(db, "kw_strong_ratio", "0.7");
+        ensureDedupSchema(db);
+    }
+
+    @Override
+    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
+        if (oldVersion < 2) {
+            ensureDedupSchema(db); // v2: cross-channel duplicate-news auto-hide
+        }
+        if (oldVersion < 3) {
+            ensureHiddenDupsSchema(db); // v3: persistent hide-decisions
+        }
+    }
+
+    // Idempotent: the "seen posts" journal + dedup tuning defaults.
+    private static void ensureDedupSchema(SQLiteDatabase db) {
+        db.execSQL("CREATE TABLE IF NOT EXISTS seen_posts ("
+                + "key TEXT PRIMARY KEY,"
+                + "dialog_id TEXT NOT NULL DEFAULT '',"
+                + "simhash TEXT NOT NULL,"
+                + "keywords TEXT NOT NULL DEFAULT '',"
+                + "msg_date INTEGER NOT NULL DEFAULT 0,"
+                + "created_at INTEGER NOT NULL DEFAULT 0)");
+        setDefaultMeta(db, "dedup_enabled", "1");
+        setDefaultMeta(db, "dup_threshold", "8");
+        setDefaultMeta(db, "dup_kw_ratio", "0.6");
+        setDefaultMeta(db, "dup_min_tokens", "8");
+        setDefaultMeta(db, "dup_seen_max_age_days", "14");
+        setDefaultMeta(db, "dup_hidden_max_age_days", "180");
+        ensureHiddenDupsSchema(db);
+    }
+
+    // Persistent hide-decisions: a hidden duplicate stays hidden even after the
+    // journal rows that triggered it are age-pruned.
+    private static void ensureHiddenDupsSchema(SQLiteDatabase db) {
+        db.execSQL("CREATE TABLE IF NOT EXISTS hidden_dups ("
+                + "key TEXT PRIMARY KEY,"
+                + "created_at INTEGER NOT NULL DEFAULT 0)");
+    }
+
+    private static void setDefaultMeta(SQLiteDatabase db, String key, String value) {
+        db.execSQL("INSERT OR IGNORE INTO meta(key, value) VALUES (?, ?)",
+                new Object[]{key, value});
+    }
+
+    public long addRule(String senderId, boolean blockSender, boolean hasSimhash,
+                        long simhash, Set<String> keywords, Set<String> domains,
+                        String textSample) {
+        SQLiteDatabase db = getWritableDatabase();
+        ContentValues cv = new ContentValues();
+        cv.put("created_at", "datetime");
+        cv.put("origin", "manual");
+        cv.put("sender_id", senderId);
+        cv.putNull("sender_name");
+        cv.put("block_sender", blockSender ? 1 : 0);
+        cv.put("simhash", hasSimhash ? Long.toUnsignedString(simhash) : null);
+        cv.put("keywords", join(keywords));
+        cv.put("domains", join(domains));
+        cv.put("text_sample", textSample);
+        cv.put("enabled", 1);
+        return db.insert("rules", null, cv);
+    }
+
+    public List<Core.Rule> loadRules() {
+        List<Core.Rule> out = new ArrayList<>();
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery(
+                "SELECT id, sender_id, block_sender, simhash, keywords, domains "
+                + "FROM rules WHERE enabled = 1", null)) {
+            while (c.moveToNext()) {
+                Core.Rule r = new Core.Rule();
+                r.id = c.getLong(0);
+                r.senderId = c.isNull(1) ? "" : c.getString(1);
+                r.blockSender = c.getInt(2) != 0;
+                if (!c.isNull(3)) {
+                    r.hasSimhash = true;
+                    r.simhash = Long.parseUnsignedLong(c.getString(3));
+                }
+                r.keywords = split(c.isNull(4) ? "" : c.getString(4));
+                r.domains = split(c.isNull(5) ? "" : c.getString(5));
+                out.add(r);
+            }
+        }
+        return out;
+    }
+
+    public Core.Config getConfig() {
+        Core.Config cfg = new Core.Config();
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery("SELECT key, value FROM meta", null)) {
+            while (c.moveToNext()) {
+                String k = c.getString(0), v = c.getString(1);
+                switch (k) {
+                    case "simhash_threshold": cfg.simhashThreshold = Integer.parseInt(v); break;
+                    case "kw_ratio": cfg.kwRatio = Double.parseDouble(v); break;
+                    case "kw_min": cfg.kwMin = Integer.parseInt(v); break;
+                    case "kw_strong_ratio": cfg.kwStrongRatio = Double.parseDouble(v); break;
+                    case "dedup_enabled": cfg.dedupEnabled = !"0".equals(v); break;
+                    case "dup_threshold": cfg.dupThreshold = Integer.parseInt(v); break;
+                    case "dup_kw_ratio": cfg.dupKwRatio = Double.parseDouble(v); break;
+                    case "dup_min_tokens": cfg.dupMinTokens = Integer.parseInt(v); break;
+                    case "dup_seen_max_age_days": cfg.dupSeenMaxAgeDays = Integer.parseInt(v); break;
+                    case "dup_hidden_max_age_days": cfg.dupHiddenMaxAgeDays = Integer.parseInt(v); break;
+                    default: break;
+                }
+            }
+        }
+        return cfg;
+    }
+
+    // --- cross-channel duplicate-news journal ---
+
+    public void addSeenPost(String key, long dialogId, long simhash, Set<String> keywords, int date) {
+        SQLiteDatabase db = getWritableDatabase();
+        ContentValues cv = new ContentValues();
+        cv.put("key", key);
+        cv.put("dialog_id", Long.toString(dialogId));
+        cv.put("simhash", Long.toUnsignedString(simhash));
+        cv.put("keywords", join(keywords));
+        cv.put("msg_date", date);
+        cv.put("created_at", date);
+        db.insertWithOnConflict("seen_posts", null, cv, SQLiteDatabase.CONFLICT_IGNORE);
+    }
+
+    // Arrival-journaling variant: created_at is the real arrival time (for age-pruning),
+    // while msg_date stays the message's own date (used by the "earliest is original" rule).
+    public void addSeenPost(String key, long dialogId, long simhash, Set<String> keywords,
+                            int msgDate, long arrivalSec) {
+        SQLiteDatabase db = getWritableDatabase();
+        ContentValues cv = new ContentValues();
+        cv.put("key", key);
+        cv.put("dialog_id", Long.toString(dialogId));
+        cv.put("simhash", Long.toUnsignedString(simhash));
+        cv.put("keywords", join(keywords));
+        cv.put("msg_date", msgDate);
+        cv.put("created_at", arrivalSec);
+        db.insertWithOnConflict("seen_posts", null, cv, SQLiteDatabase.CONFLICT_IGNORE);
+    }
+
+    public void addHiddenDup(String key, long nowSec) {
+        SQLiteDatabase db = getWritableDatabase();
+        ContentValues cv = new ContentValues();
+        cv.put("key", key);
+        cv.put("created_at", nowSec);
+        db.insertWithOnConflict("hidden_dups", null, cv, SQLiteDatabase.CONFLICT_IGNORE);
+    }
+
+    public Set<String> loadHiddenDupKeys() {
+        Set<String> out = new HashSet<>();
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery("SELECT key FROM hidden_dups", null)) {
+            while (c.moveToNext()) {
+                out.add(c.getString(0));
+            }
+        }
+        return out;
+    }
+
+    public void pruneSeenByAge(long cutoffSec) {
+        getWritableDatabase().execSQL("DELETE FROM seen_posts WHERE created_at < ?",
+                new Object[]{cutoffSec});
+    }
+
+    public void pruneHiddenDups(long cutoffSec) {
+        getWritableDatabase().execSQL("DELETE FROM hidden_dups WHERE created_at < ?",
+                new Object[]{cutoffSec});
+    }
+
+    public List<Core.SeenPost> loadSeenPosts(int limit) {
+        List<Core.SeenPost> out = new ArrayList<>();
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery(
+                "SELECT key, dialog_id, simhash, keywords, msg_date FROM seen_posts "
+                + "ORDER BY msg_date DESC LIMIT ?", new String[]{Integer.toString(limit)})) {
+            while (c.moveToNext()) {
+                Core.SeenPost p = new Core.SeenPost();
+                p.key = c.getString(0);
+                try {
+                    p.dialogId = Long.parseLong(c.isNull(1) ? "0" : c.getString(1));
+                } catch (Exception e) {
+                    p.dialogId = 0;
+                }
+                p.simhash = Long.parseUnsignedLong(c.getString(2));
+                p.keywords = split(c.isNull(3) ? "" : c.getString(3));
+                p.date = c.getInt(4);
+                out.add(p);
+            }
+        }
+        return out;
+    }
+
+    public void pruneSeen(int maxRows) {
+        getWritableDatabase().execSQL(
+                "DELETE FROM seen_posts WHERE key NOT IN "
+                + "(SELECT key FROM seen_posts ORDER BY msg_date DESC LIMIT ?)",
+                new Object[]{maxRows});
+    }
+
+    public boolean isSeeded() {
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery("SELECT value FROM meta WHERE key = 'seeded'", null)) {
+            return c.moveToNext() && "1".equals(c.getString(0));
+        }
+    }
+
+    public void markSeeded() {
+        getWritableDatabase().execSQL(
+                "INSERT OR REPLACE INTO meta(key, value) VALUES ('seeded', '1')");
+    }
+
+    private static String join(Set<String> items) {
+        StringBuilder sb = new StringBuilder();
+        for (String x : new TreeSet<>(items)) {
+            if (sb.length() > 0) sb.append(' ');
+            sb.append(x);
+        }
+        return sb.toString();
+    }
+
+    private static Set<String> split(String s) {
+        Set<String> out = new HashSet<>();
+        for (String t : s.trim().split("\\s+")) {
+            if (!t.isEmpty()) out.add(t);
+        }
+        return out;
+    }
+}
