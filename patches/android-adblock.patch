index 61a65305..166ebd8f 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -17,6 +17,7 @@ configurations.all {
 }
 
 dependencies {
+    implementation 'com.microsoft.onnxruntime:onnxruntime-android:1.20.0' // ad-blocker: on-device semantic embeddings (experimental)
     implementation 'androidx.core:core:1.16.0'
     implementation 'androidx.palette:palette:1.0.0'
     implementation 'androidx.exifinterface:exifinterface:1.3.6'
@@ -87,6 +88,10 @@ android {
     buildToolsVersion '35.0.0'
     ndkVersion "27.2.12479018"
 
+    aaptOptions {
+        noCompress "onnx" // ad-blocker: keep the embedding model uncompressed (mmap-friendly)
+    }
+
     sourceSets.main.jniLibs.srcDirs = ['./jni/']
 
     externalNativeBuild {
