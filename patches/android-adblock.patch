+package com.tgadblock;
+
+/**
+ * Single source of truth for the ad-blocker build version.
+ *
+ * Bump {@link #ADBLOCK_VERSION} on every published build. CI tags the GitHub
+ * release {@code tg-adblock-v<ADBLOCK_VERSION>} (it greps this constant out of
+ * the patch), and the in-app {@link UpdateChecker} compares this baked-in value
+ * to the latest release to decide whether to offer an update.
+ */
+public final class Version {
+    private Version() {}
+
+    public static final int ADBLOCK_VERSION = 4;
+    public static final String ADBLOCK_VERSION_NAME = "4.0";
+
+    /** owner/repo that publishes the signed APKs. */
+    public static final String REPO = "FIREguardSPB/tg-adblock";
+}
