index 00000000..adfd1c22
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/AdFilter.java
@@ -0,0 +1,205 @@
+package com.tgadblock;
+
+import android.content.Context;
+
+import org.telegram.messenger.MessageObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * In-client glue for the offline-validated detection pipeline (Android).
+ * Bridges MessageObject -> Normalize/Core and owns the SQLite rule store.
+ * Call {@link #init(Context)} once (e.g. from ApplicationLoader) before use.
+ */
+public final class AdFilter {
+    private static volatile AdFilter instance;
+
+    private final AdStore store;
+    private List<Core.Rule> rules;
+    private Core.Config config;
+    private final Map<Integer, Boolean> cache = new HashMap<>();
+
+    private static final Pattern DOMAIN = Pattern.compile(
+            "(?:https?://|www\\.)?([a-z0-9.-]+\\.(?:ru|com|net|org|io|me|app|xyz|cc|biz|info))");
+
+    private AdFilter(Context ctx) {
+        store = new AdStore(ctx);
+        seedDefaultsIfNeeded(ctx);
+        reload();
+    }
+
+    // On first launch, load the bundled starter ruleset so common ads are hidden
+    // out of the box. Preseed rules carry no sender, so they fire via SimHash
+    // near-dup, strong keyword overlap, or a known ad-domain match.
+    private void seedDefaultsIfNeeded(Context ctx) {
+        if (store.isSeeded()) {
+            return;
+        }
+        try (java.io.InputStream is = ctx.getAssets().open("adblock_default_rules.json")) {
+            java.io.ByteArrayOutputStream bos = new java.io.ByteArrayOutputStream();
+            byte[] buf = new byte[4096];
+            int n;
+            while ((n = is.read(buf)) > 0) {
+                bos.write(buf, 0, n);
+            }
+            org.json.JSONArray arr = new org.json.JSONArray(
+                    new String(bos.toByteArray(), java.nio.charset.StandardCharsets.UTF_8));
+            for (int i = 0; i < arr.length(); i++) {
+                org.json.JSONObject o = arr.getJSONObject(i);
+                store.addRule(
+                        "",
+                        o.optBoolean("block_sender", false),
+                        true,
+                        Long.parseUnsignedLong(o.getString("simhash")),
+                        jsonToSet(o.optJSONArray("keywords")),
+                        jsonToSet(o.optJSONArray("domains")),
+                        o.optString("text_sample", ""));
+            }
+        } catch (Throwable ignore) {
+            // missing/malformed asset -> skip preseed (manual tap-to-block still works)
+        }
+        store.markSeeded();
+    }
+
+    private static Set<String> jsonToSet(org.json.JSONArray a) {
+        Set<String> out = new HashSet<>();
+        if (a != null) {
+            for (int i = 0; i < a.length(); i++) {
+                out.add(a.optString(i));
+            }
+        }
+        return out;
+    }
+
+    public static void init(Context ctx) {
+        if (instance == null) {
+            synchronized (AdFilter.class) {
+                if (instance == null) instance = new AdFilter(ctx.getApplicationContext());
+            }
+        }
+    }
+
+    public static AdFilter getInstance() {
+        return instance;
+    }
+
+    public synchronized void reload() {
+        rules = store.loadRules();
+        config = store.getConfig();
+        cache.clear();
+    }
+
+    private static String textOf(MessageObject mo) {
+        if (mo.messageOwner != null && mo.messageOwner.message != null) {
+            return mo.messageOwner.message;
+        }
+        return mo.messageText != null ? mo.messageText.toString() : null;
+    }
+
+    // Inline-keyboard button labels. Lets us detect/block ads that carry no body
+    // text (round-video "video notes", stickers) but route to an ad via a button
+    // like "Игра в которой зарабатываю".
+    private static String buttonText(MessageObject mo) {
+        if (mo == null || mo.messageOwner == null
+                || mo.messageOwner.reply_markup == null
+                || mo.messageOwner.reply_markup.rows == null) {
+            return "";
+        }
+        StringBuilder sb = new StringBuilder();
+        for (TLRPC.TL_keyboardButtonRow row : mo.messageOwner.reply_markup.rows) {
+            if (row == null || row.buttons == null) continue;
+            for (TLRPC.KeyboardButton b : row.buttons) {
+                if (b != null && b.text != null && !b.text.isEmpty()) {
+                    if (sb.length() > 0) sb.append(' ');
+                    sb.append(b.text);
+                }
+            }
+        }
+        return sb.toString();
+    }
+
+    // Body text if present, otherwise the button labels. Messages with a body keep
+    // their previously-validated behaviour; button-only messages become detectable.
+    private static String effectiveText(MessageObject mo) {
+        String body = textOf(mo);
+        if (body != null && !body.trim().isEmpty()) {
+            return body;
+        }
+        return buttonText(mo);
+    }
+
+    // Whether the "Block as ad" menu item should be offered for this message.
+    public static boolean hasBlockableText(MessageObject mo) {
+        String t = effectiveText(mo);
+        return t != null && !t.trim().isEmpty();
+    }
+
+    private static String senderId(MessageObject mo) {
+        return String.valueOf(mo.getSenderId());
+    }
+
+    private static Set<String> domains(String raw) {
+        Set<String> out = new HashSet<>();
+        Matcher m = DOMAIN.matcher(raw.toLowerCase(Locale.ROOT));
+        while (m.find()) {
+            String host = m.group(1);
+            if (host.startsWith("www.")) host = host.substring(4);
+            out.add(host);
+        }
+        return out;
+    }
+
+    // A grouped media message (album) is rendered as one cell per item, but only
+    // the caption-bearing item carries the ad text. Treat the whole group as an ad
+    // if any of its items is — so every cell in the album collapses together
+    // instead of leaving orphaned photos and overlapping siblings.
+    public synchronized boolean isAdGroup(MessageObject.GroupedMessages group) {
+        if (group == null || group.messages == null) return false;
+        for (int i = 0; i < group.messages.size(); i++) {
+            if (isAd(group.messages.get(i))) return true;
+        }
+        return false;
+    }
+
+    public synchronized boolean isAd(MessageObject mo) {
+        if (mo == null || rules.isEmpty()) return false;
+        Integer key = mo.getId();
+        Boolean cached = cache.get(key);
+        if (cached != null) return cached;
+        String text = effectiveText(mo);
+        boolean blocked = false;
+        if (text != null && !text.trim().isEmpty()) {
+            Core.MsgFeat f = new Core.MsgFeat();
+            f.senderId = senderId(mo);
+            f.simhash = Normalize.simhashOf(text);
+            f.tokens = Normalize.tokenSet(text);
+            f.domains = domains(text);
+            blocked = Core.classify(rules, f, config).blocked;
+        }
+        cache.put(key, blocked);
+        return blocked;
+    }
+
+    public synchronized void blockItem(MessageObject mo) {
+        if (mo == null) return;
+        String text = effectiveText(mo);
+        if (text == null || text.trim().isEmpty()) return;
+        store.addRule(
+                senderId(mo),
+                /*blockSender=*/false,
+                /*hasSimhash=*/true,
+                Normalize.simhashOf(text),
+                Normalize.keywords(text),
+                domains(text),
+                text.length() > 280 ? text.substring(0, 280) : text);
+        reload();
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/AdStore.java b/TMessagesProj/src/main/java/com/tgadblock/AdStore.java
new file mode 100644
index 00000000..af232cbd
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/AdStore.java
@@ -0,0 +1,147 @@
+package com.tgadblock;
+
+import android.content.ContentValues;
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+import android.database.sqlite.SQLiteOpenHelper;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * SQLite rule store (Android). Schema is the byte-compatible twin of the Python
+ * tg_adblock.rules and the C++ AdStore, so a rules.db produced by any of them
+ * loads here unchanged (verified bidirectionally for the Python<->C++ pair).
+ */
+public final class AdStore extends SQLiteOpenHelper {
+    private static final String DB_NAME = "adblock_rules.db";
+    private static final int DB_VERSION = 1;
+
+    public AdStore(Context ctx) {
+        super(ctx.getApplicationContext(), DB_NAME, null, DB_VERSION);
+    }
+
+    @Override
+    public void onCreate(SQLiteDatabase db) {
+        db.execSQL("CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)");
+        db.execSQL("CREATE TABLE IF NOT EXISTS rules ("
+                + "id INTEGER PRIMARY KEY AUTOINCREMENT,"
+                + "created_at TEXT NOT NULL,"
+                + "origin TEXT NOT NULL DEFAULT 'manual',"
+                + "sender_id TEXT,"
+                + "sender_name TEXT,"
+                + "block_sender INTEGER NOT NULL DEFAULT 0,"
+                + "simhash TEXT,"
+                + "keywords TEXT NOT NULL DEFAULT '',"
+                + "domains TEXT NOT NULL DEFAULT '',"
+                + "text_sample TEXT NOT NULL DEFAULT '',"
+                + "enabled INTEGER NOT NULL DEFAULT 1)");
+        setDefaultMeta(db, "schema_version", "1");
+        setDefaultMeta(db, "simhash_threshold", "8");
+        setDefaultMeta(db, "kw_ratio", "0.35");
+        setDefaultMeta(db, "kw_min", "3");
+        setDefaultMeta(db, "kw_strong_ratio", "0.7");
+    }
+
+    @Override
+    public void onUpgrade(SQLiteDatabase db, int oldVersion, int newVersion) {
+        // Schema v1 only so far; nothing to migrate.
+    }
+
+    private static void setDefaultMeta(SQLiteDatabase db, String key, String value) {
+        db.execSQL("INSERT OR IGNORE INTO meta(key, value) VALUES (?, ?)",
+                new Object[]{key, value});
+    }
+
+    public long addRule(String senderId, boolean blockSender, boolean hasSimhash,
+                        long simhash, Set<String> keywords, Set<String> domains,
+                        String textSample) {
+        SQLiteDatabase db = getWritableDatabase();
+        ContentValues cv = new ContentValues();
+        cv.put("created_at", "datetime");
+        cv.put("origin", "manual");
+        cv.put("sender_id", senderId);
+        cv.putNull("sender_name");
+        cv.put("block_sender", blockSender ? 1 : 0);
+        cv.put("simhash", hasSimhash ? Long.toUnsignedString(simhash) : null);
+        cv.put("keywords", join(keywords));
+        cv.put("domains", join(domains));
+        cv.put("text_sample", textSample);
+        cv.put("enabled", 1);
+        return db.insert("rules", null, cv);
+    }
+
+    public List<Core.Rule> loadRules() {
+        List<Core.Rule> out = new ArrayList<>();
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery(
+                "SELECT id, sender_id, block_sender, simhash, keywords, domains "
+                + "FROM rules WHERE enabled = 1", null)) {
+            while (c.moveToNext()) {
+                Core.Rule r = new Core.Rule();
+                r.id = c.getLong(0);
+                r.senderId = c.isNull(1) ? "" : c.getString(1);
+                r.blockSender = c.getInt(2) != 0;
+                if (!c.isNull(3)) {
+                    r.hasSimhash = true;
+                    r.simhash = Long.parseUnsignedLong(c.getString(3));
+                }
+                r.keywords = split(c.isNull(4) ? "" : c.getString(4));
+                r.domains = split(c.isNull(5) ? "" : c.getString(5));
+                out.add(r);
+            }
+        }
+        return out;
+    }
+
+    public Core.Config getConfig() {
+        Core.Config cfg = new Core.Config();
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery("SELECT key, value FROM meta", null)) {
+            while (c.moveToNext()) {
+                String k = c.getString(0), v = c.getString(1);
+                switch (k) {
+                    case "simhash_threshold": cfg.simhashThreshold = Integer.parseInt(v); break;
+                    case "kw_ratio": cfg.kwRatio = Double.parseDouble(v); break;
+                    case "kw_min": cfg.kwMin = Integer.parseInt(v); break;
+                    case "kw_strong_ratio": cfg.kwStrongRatio = Double.parseDouble(v); break;
+                    default: break;
+                }
+            }
+        }
+        return cfg;
+    }
+
+    public boolean isSeeded() {
+        SQLiteDatabase db = getReadableDatabase();
+        try (Cursor c = db.rawQuery("SELECT value FROM meta WHERE key = 'seeded'", null)) {
+            return c.moveToNext() && "1".equals(c.getString(0));
+        }
+    }
+
+    public void markSeeded() {
+        getWritableDatabase().execSQL(
+                "INSERT OR REPLACE INTO meta(key, value) VALUES ('seeded', '1')");
+    }
+
+    private static String join(Set<String> items) {
+        StringBuilder sb = new StringBuilder();
+        for (String x : new TreeSet<>(items)) {
+            if (sb.length() > 0) sb.append(' ');
+            sb.append(x);
+        }
+        return sb.toString();
+    }
+
+    private static Set<String> split(String s) {
+        Set<String> out = new HashSet<>();
+        for (String t : s.trim().split("\\s+")) {
+            if (!t.isEmpty()) out.add(t);
+        }
+        return out;
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/Core.java b/TMessagesProj/src/main/java/com/tgadblock/Core.java
new file mode 100644
index 00000000..12996c46
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/Core.java
@@ -0,0 +1,136 @@
+package com.tgadblock;
+
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Portable ad-detection core (Java port).
+ *
+ * Byte-for-byte twin of the Python reference (tg_adblock) and the C++ core:
+ * FNV-1a over UTF-8 bytes, classic 64-bit SimHash, and the same layered
+ * keyword/sender/SimHash decision. Verified identical to Python via generated
+ * test vectors (see TestCore.java + gen_vectors_java.py).
+ *
+ * As in the other ports, text normalization (text -> tokens/features) is NOT
+ * done here; on Android it is done with the platform/ICU-aware helpers in
+ * AdFilter so it matches Python's NFKC + \w+ tokenization.
+ */
+public final class Core {
+    private Core() {}
+
+    private static final long FNV_OFFSET = 0xCBF29CE484222325L;
+    private static final long FNV_PRIME = 0x100000001B3L;
+
+    public static long fnv1a64(String feature) {
+        long h = FNV_OFFSET;
+        for (byte b : feature.getBytes(java.nio.charset.StandardCharsets.UTF_8)) {
+            h ^= (b & 0xFFL);
+            h *= FNV_PRIME; // wraps mod 2^64 (signed long arithmetic is identical)
+        }
+        return h;
+    }
+
+    public static long simhash(List<String> features) {
+        if (features.isEmpty()) {
+            return 0L;
+        }
+        int[] v = new int[64];
+        for (String feat : features) {
+            long h = fnv1a64(feat);
+            for (int i = 0; i < 64; i++) {
+                if (((h >>> i) & 1L) != 0) v[i] += 1;
+                else v[i] -= 1;
+            }
+        }
+        long out = 0L;
+        for (int i = 0; i < 64; i++) {
+            if (v[i] > 0) out |= (1L << i);
+        }
+        return out;
+    }
+
+    public static int hamming(long a, long b) {
+        return Long.bitCount(a ^ b);
+    }
+
+    public static final class Config {
+        public int simhashThreshold = 8;
+        public double kwRatio = 0.35;
+        public int kwMin = 3;
+        public double kwStrongRatio = 0.7;
+    }
+
+    public static final class Rule {
+        public long id;
+        public String senderId = "";   // empty => no sender bound
+        public boolean blockSender = false;
+        public boolean hasSimhash = false;
+        public long simhash = 0L;
+        public Set<String> keywords = java.util.Collections.emptySet();
+        public Set<String> domains = java.util.Collections.emptySet();
+        public boolean enabled = true;
+    }
+
+    public static final class MsgFeat {
+        public String senderId = "";
+        public long simhash = 0L;
+        public Set<String> tokens = java.util.Collections.emptySet();
+        public Set<String> domains = java.util.Collections.emptySet();
+    }
+
+    public static final class Match {
+        public boolean blocked = false;
+        public long ruleId = -1;
+        public String reason = "";
+        public int distance = -1;
+    }
+
+    private static int intersectionSize(Set<String> a, Set<String> b) {
+        Set<String> small = (a.size() <= b.size()) ? a : b;
+        Set<String> big = (a.size() <= b.size()) ? b : a;
+        int n = 0;
+        for (String x : small) if (big.contains(x)) n++;
+        return n;
+    }
+
+    public static Match classify(List<Rule> rules, MsgFeat msg, Config cfg) {
+        for (Rule rule : rules) {
+            if (!rule.enabled) continue;
+            boolean senderMatch = rule.senderId != null && !rule.senderId.isEmpty()
+                    && rule.senderId.equals(msg.senderId);
+
+            if (rule.blockSender && senderMatch) {
+                return match(rule.id, "sender", -1);
+            }
+            if (rule.hasSimhash && !msg.tokens.isEmpty()) {
+                int d = hamming(rule.simhash, msg.simhash);
+                if (d <= cfg.simhashThreshold) {
+                    return match(rule.id, "simhash", d);
+                }
+            }
+            if (!rule.keywords.isEmpty() && rule.keywords.size() >= cfg.kwMin
+                    && !msg.tokens.isEmpty()) {
+                double overlap = (double) intersectionSize(rule.keywords, msg.tokens)
+                        / (double) rule.keywords.size();
+                boolean domainMatch = !rule.domains.isEmpty()
+                        && intersectionSize(rule.domains, msg.domains) > 0;
+                if (overlap >= cfg.kwRatio && (senderMatch || domainMatch)) {
+                    return match(rule.id, "keyword+context", -1);
+                }
+                if (overlap >= cfg.kwStrongRatio) {
+                    return match(rule.id, "keyword", -1);
+                }
+            }
+        }
+        return new Match();
+    }
+
+    private static Match match(long id, String reason, int distance) {
+        Match m = new Match();
+        m.blocked = true;
+        m.ruleId = id;
+        m.reason = reason;
+        m.distance = distance;
+        return m;
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/Normalize.java b/TMessagesProj/src/main/java/com/tgadblock/Normalize.java
new file mode 100644
index 00000000..683ee79a
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/Normalize.java
@@ -0,0 +1,94 @@
+package com.tgadblock;
+
+import java.text.Normalizer;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Text normalization for the Android port — pure JDK (no android.* deps), so it
+ * compiles and is parity-tested off-device. Mirrors tg_adblock.normalize:
+ * NFKC + lowercase + strip urls/mentions + Unicode-aware \w tokenization.
+ */
+public final class Normalize {
+    private Normalize() {}
+
+    private static final Pattern URL = Pattern.compile(
+            "(?:https?://|www\\.)\\S+"
+          + "|\\b\\S+\\.(?:ru|com|net|org|io|me|app|xyz|cc|biz|info)\\b/?\\S*",
+            Pattern.CASE_INSENSITIVE);
+    private static final Pattern TME = Pattern.compile("\\bt\\.me/\\S+", Pattern.CASE_INSENSITIVE);
+    private static final Pattern MENTION = Pattern.compile("@[A-Za-z0-9_]{3,}");
+    private static final Pattern WS = Pattern.compile("\\s+");
+    // NB: Android's java.util.regex rejects Pattern.UNICODE_CHARACTER_CLASS, so we
+    // match Unicode letters+numbers explicitly via \p{L}\p{N} — works on both
+    // Android and the desktop JDK and stays parity-identical to Python's \w.
+    private static final Pattern TOKEN = Pattern.compile("[\\p{L}\\p{N}]+");
+
+    private static final Set<String> STOPWORDS = new HashSet<>(Arrays.asList(
+        "и","в","во","не","что","он","на","я","с","со","как","а","то","все",
+        "она","так","его","но","да","ты","к","у","же","вы","за","бы","по",
+        "только","ее","мне","было","вот","от","меня","о","из","ему","теперь",
+        "когда","даже","ну","вдруг","ли","если","уже","или","быть","был","до",
+        "вас","нибудь","опять","уж","вам","ведь","там","потом","себя","ничего",
+        "ей","может","они","тут","где","есть","надо","для","это","этот","эта",
+        "эти","тот","том","чем","чтобы","нас","про",
+        "the","a","an","and","or","but","if","of","to","in","on","for","with",
+        "as","is","are","was","be","this","that","it","at","by","from","you",
+        "your","we","our","can","will","all","not","have"
+    ));
+
+    public static String normalizeText(String s) {
+        if (s == null || s.isEmpty()) return "";
+        String n = Normalizer.normalize(s, Normalizer.Form.NFKC).toLowerCase(Locale.ROOT);
+        n = URL.matcher(n).replaceAll(" ");
+        n = TME.matcher(n).replaceAll(" ");
+        n = MENTION.matcher(n).replaceAll(" ");
+        return WS.matcher(n).replaceAll(" ").trim();
+    }
+
+    public static List<String> tokens(String s) {
+        List<String> out = new ArrayList<>();
+        Matcher m = TOKEN.matcher(normalizeText(s));
+        while (m.find()) out.add(m.group());
+        return out;
+    }
+
+    public static Set<String> tokenSet(String s) {
+        return new HashSet<>(tokens(s));
+    }
+
+    private static List<String> significant(String s) {
+        List<String> out = new ArrayList<>();
+        for (String t : tokens(s)) {
+            if (t.length() >= 3 && !STOPWORDS.contains(t)) out.add(t);
+        }
+        return out;
+    }
+
+    public static Set<String> keywords(String s) {
+        Set<String> out = new HashSet<>();
+        for (String t : tokens(s)) {
+            if (t.length() >= 4 && !STOPWORDS.contains(t)) out.add(t);
+        }
+        return out;
+    }
+
+    public static List<String> features(String s) {
+        List<String> sig = significant(s);
+        List<String> out = new ArrayList<>(sig);
+        for (int i = 0; i + 1 < sig.size(); i++) {
+            out.add(sig.get(i) + "_" + sig.get(i + 1));
+        }
+        return out;
+    }
+
+    public static long simhashOf(String s) {
+        return Core.simhash(features(s));
+    }
+}
diff --git a/TMessagesProj/src/main/java/com/tgadblock/UpdateChecker.java b/TMessagesProj/src/main/java/com/tgadblock/UpdateChecker.java
new file mode 100644
index 00000000..91c8eeb7
--- /dev/null
+++ b/TMessagesProj/src/main/java/com/tgadblock/UpdateChecker.java
@@ -0,0 +1,166 @@
+package com.tgadblock;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.net.Uri;
+import android.os.Build;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Once a day, ask GitHub for the latest published ad-blocker release and, if it
+ * is newer than this build ({@link Version#ADBLOCK_VERSION}), post a notification
+ * that opens the APK download. Everything is best-effort and swallows failures —
+ * a missing network / permission must never affect the host app.
+ *
+ * Install is intentionally NOT silent: tapping the notification opens the release
+ * APK in the browser and the user installs it like any sideload (an in-place
+ * update keeps all blocked-ad rules, since package + signing key are unchanged).
+ */
+public final class UpdateChecker {
+    private UpdateChecker() {}
+
+    private static final String PREFS = "tgadblock_update";
+    private static final String KEY_LAST = "last_check";
+    private static final long INTERVAL_MS = 24L * 60 * 60 * 1000; // once a day
+    private static final String CHANNEL_ID = "tgadblock_updates";
+    private static final int NOTIF_ID = 0x7ADB10C;
+    private static final Pattern TAG_VERSION = Pattern.compile("v(\\d+)");
+
+    public static void maybeCheck(Context ctx) {
+        if (ctx == null) return;
+        try {
+            final Context app = ctx.getApplicationContext();
+            SharedPreferences sp = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            long now = System.currentTimeMillis();
+            if (now - sp.getLong(KEY_LAST, 0) < INTERVAL_MS) return;
+            sp.edit().putLong(KEY_LAST, now).apply();
+            Thread t = new Thread(new Runnable() {
+                @Override public void run() {
+                    check(app);
+                }
+            }, "tgadblock-update");
+            t.setDaemon(true);
+            t.start();
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static void check(Context app) {
+        HttpURLConnection conn = null;
+        try {
+            URL url = new URL("https://api.github.com/repos/" + Version.REPO + "/releases/latest");
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setRequestProperty("Accept", "application/vnd.github+json");
+            conn.setRequestProperty("User-Agent", "tg-adblock");
+            conn.setConnectTimeout(15000);
+            conn.setReadTimeout(15000);
+            if (conn.getResponseCode() != 200) return;
+            JSONObject o = new JSONObject(readAll(conn.getInputStream()));
+
+            Matcher m = TAG_VERSION.matcher(o.optString("tag_name", ""));
+            if (!m.find()) return;
+            int remote = Integer.parseInt(m.group(1));
+            if (remote <= Version.ADBLOCK_VERSION) return;
+
+            String apkUrl = null;
+            JSONArray assets = o.optJSONArray("assets");
+            if (assets != null) {
+                for (int i = 0; i < assets.length(); i++) {
+                    JSONObject a = assets.getJSONObject(i);
+                    if (a.optString("name", "").toLowerCase(Locale.ROOT).endsWith(".apk")) {
+                        apkUrl = a.optString("browser_download_url", null);
+                        break;
+                    }
+                }
+            }
+            if (apkUrl == null) {
+                apkUrl = o.optString("html_url", null);
+            }
+            postNotification(app, remote, apkUrl);
+        } catch (Throwable ignore) {
+        } finally {
+            if (conn != null) {
+                try { conn.disconnect(); } catch (Throwable ignore) {}
+            }
+        }
+    }
+
+    private static void postNotification(Context app, int remote, String url) {
+        if (url == null || url.isEmpty()) return;
+        try {
+            NotificationManager nm =
+                    (NotificationManager) app.getSystemService(Context.NOTIFICATION_SERVICE);
+            if (nm == null) return;
+            boolean ru = isRu();
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                nm.createNotificationChannel(new NotificationChannel(CHANNEL_ID,
+                        ru ? "Обновления Telegram AAD" : "Telegram AAD updates",
+                        NotificationManager.IMPORTANCE_DEFAULT));
+            }
+
+            Intent view = new Intent(Intent.ACTION_VIEW, Uri.parse(url));
+            view.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            int piFlags = PendingIntent.FLAG_UPDATE_CURRENT;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                piFlags |= PendingIntent.FLAG_IMMUTABLE;
+            }
+            PendingIntent pi = PendingIntent.getActivity(app, 0, view, piFlags);
+
+            String title = ru ? "Доступна новая версия Telegram AAD"
+                              : "New Telegram AAD version available";
+            String text = ru ? ("Версия v" + remote + " — нажмите, чтобы скачать и обновить")
+                             : ("Version v" + remote + " — tap to download and update");
+
+            Notification.Builder b = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
+                    ? new Notification.Builder(app, CHANNEL_ID)
+                    : new Notification.Builder(app);
+            Notification n = b
+                    .setSmallIcon(android.R.drawable.stat_sys_download_done)
+                    .setContentTitle(title)
+                    .setContentText(text)
+                    .setStyle(new Notification.BigTextStyle().bigText(text))
+                    .setAutoCancel(true)
+                    .setContentIntent(pi)
+                    .build();
+            nm.notify(NOTIF_ID, n);
+        } catch (Throwable ignore) {
+        }
+    }
+
+    private static boolean isRu() {
+        try {
+            org.telegram.messenger.LocaleController.LocaleInfo li =
+                    org.telegram.messenger.LocaleController.getInstance().getCurrentLocaleInfo();
+            return li != null && li.shortName != null
+                    && li.shortName.toLowerCase(Locale.ROOT).startsWith("ru");
+        } catch (Throwable ignore) {
+            return false;
+        }
+    }
+
+    private static String readAll(InputStream is) throws Exception {
+        ByteArrayOutputStream bos = new ByteArrayOutputStream();
+        byte[] buf = new byte[4096];
+        int n;
+        while ((n = is.read(buf)) > 0) {
+            bos.write(buf, 0, n);
+        }
+        return new String(bos.toByteArray(), StandardCharsets.UTF_8);
+    }
+}
